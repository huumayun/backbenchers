rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserDoc(userId) {
      return request.resource.data.keys().hasAny(['uid', 'email', 'unlockedSubjects', 'activeSessionId', 'hasAccess'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
    }

    function isValidReadingDataDoc(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId);
    }

    function isValidSessionDoc(userId) {
      return request.resource.data.keys().hasAll(['userId', 'sessionId', 'sessionToken'])
        && request.resource.data.userId == userId;
    }

    function isValidUnlockCodeDoc(codeId) {
      return request.resource.data.keys().hasAll(['code', 'used'])
        && request.resource.data.code == codeId
        && request.resource.data.used is bool;
    }

    // ─── 1. Users Collection (users/{userId}) ──────────────────────────────────
    // Stores user account info, permanently unlocked subjects (unlockedSubjects),
    // redeemedCodes, subjectAccess map (permanent & timed), and active session reference.
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isOwner(userId) || isValidUserDoc(userId);
      allow delete: if false;
    }

    // ─── 2. User Reading Data (user_reading_data/{userId}) ─────────────────────
    // Stores per-book reading progress (Last Read), subject-wise bookmarks,
    // reader preferences (theme, fontSize), and synced unlockedSubjects list.
    match /user_reading_data/{userId} {
      allow get: if true;
      allow create, update: if isOwner(userId) || isValidReadingDataDoc(userId);
      allow delete: if false;
    }

    // ─── 3. Single Active Login Sessions (login_sessions/{userId}) ─────────────
    // Enforces 1 active login session per user across devices/browsers.
    // New login overwrites sessionId & sessionToken, invalidating previous devices.
    match /login_sessions/{userId} {
      allow get: if true;
      allow create, update: if isOwner(userId) || isValidSessionDoc(userId);
      allow delete: if true;
    }

    // ─── 4. Unlock Codes (unlock_codes/{codeId}) ───────────────────────────────
    // Stores generated unlock codes, assignedSubjectIds (1 to 7 subjects),
    // maxUses, usedCount, redeemers list, accessDurationDays, expiresAt, disabled.
    match /unlock_codes/{codeId} {
      allow get, list: if true;
      allow create, update: if isValidUnlockCodeDoc(codeId);
      allow delete: if true;
    }

    // ─── 5. Site Settings (settings/{docId}) ───────────────────────────────────
    // Stores dynamic site config (settings/site): price, freeSubjects windows,
    // notices list, Telegram link, WhatsApp number, bKash/Nagad payment info.
    // Readable by everyone (including guests) so free windows & notices work everywhere.
    match /settings/{docId} {
      allow get, list: if true;
      allow create, update: if docId == "site" || docId == "admin_credentials";
      allow delete: if false;
    }

    // ─── 6. Notices Collection (notices/{noticeId}) ────────────────────────────
    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // ─── 7. Legacy / Direct Client Collections ─────────────────────────────────
    match /reading_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /bookmarks/{bookmarkId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}

